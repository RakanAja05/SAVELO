    {
      "name": "4. Itineraries",
      "item": [
        {
          "name": "4.1 Generate Itinerary",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Itinerary generated', () => {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json.data.itineraries).to.be.an('array');",
                  "    if (json.data.itineraries.length > 0) {",
                  "        pm.collectionVariables.set('itinerary_id', json.data.itineraries[0].id);",
                  "        pm.collectionVariables.set('request_id', json.data.request.id);",
                  "        console.log('✓ itinerary_id:', json.data.itineraries[0].id);",
                  "        console.log('✓ request_id:', json.data.request.id);",
                  "    }",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [{"key": "token", "value": "{{auth_token}}", "type": "string"}]
            },
            "method": "POST",
            "header": [
              {"key": "Content-Type", "value": "application/json"},
              {"key": "Accept", "value": "application/json"}
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"origin\": \"Jakarta\",\n  \"destination_label\": \"{{test_city}}\",\n  \"duration_days\": 3,\n  \"num_people\": 2,\n  \"budget\": 2000000\n}"
            },
            "url": {
              "raw": "{{base_url}}/itineraries/generate",
              "host": ["{{base_url}}"],
              "path": ["itineraries", "generate"]
            }
          }
        },
        {
          "name": "4.2 Get Itinerary Detail",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.collectionVariables.get('itinerary_id')) {",
                  "    pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "    pm.test('Has itinerary data', () => {",
                  "        const json = pm.response.json();",
                  "        pm.expect(json.data.itinerary).to.be.an('object');",
                  "        if (json.data.itinerary.days && json.data.itinerary.days[0]) {",
                  "            const firstItem = json.data.itinerary.days[0].items[0];",
                  "            if (firstItem) {",
                  "                pm.collectionVariables.set('item_id', firstItem.id);",
                  "                console.log('✓ item_id:', firstItem.id);",
                  "            }",
                  "        }",
                  "    });",
                  "} else {",
                  "    pm.test.skip('No itinerary_id available');",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
