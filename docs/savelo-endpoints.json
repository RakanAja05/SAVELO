          "name": "4.8 Update Itinerary Item",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.collectionVariables.get('item_id') && pm.collectionVariables.get('place_id')) {",
                  "    pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "} else {",
                  "    pm.test.skip('No item_id or place_id available');",
                  "}"
                ],
                "type": "text/javascript"
              }
