              "type": "bearer",
              "bearer": [{"key": "token", "value": "{{auth_token}}", "type": "string"}]
            },
            "method": "PATCH",
            "header": [
              {"key": "Content-Type", "value": "application/json"},
              {"key": "Accept", "value": "application/json"}
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"transport_mode_id\": {{transport_mode_id}}\n}"
            },
            "url": {
              "raw": "{{base_url}}/itineraries/{{itinerary_id}}/items/{{item_id}}/checkin",
              "host": ["{{base_url}}"],
