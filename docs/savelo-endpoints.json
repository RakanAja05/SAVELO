{
  "info": {
    "name": "Savelo API - Complete Endpoints",
    "_postman_id": "savelo-complete-collection",
    "description": "Complete Savelo API collection untuk testing semua endpoint.\n\n**Cara Pakai:**\n1. Import collection ini ke Postman\n2. Klik tombol 'Run' atau gunakan Collection Runner\n3. Semua request akan berjalan otomatis dengan token dan ID yang tersimpan\n\n**Catatan:**\n- Token dari login/register otomatis tersimpan ke variable `auth_token`\n- ID dari response (itinerary_id, place_id, dll) otomatis tersimpan\n- Endpoint yang membutuhkan auth akan otomatis menggunakan token\n\nVariable `base_url` default: http://localhost:8000/api",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8000/api",
      "type": "string"
    },
    {
      "key": "test_email",
      "value": "test{{$timestamp}}@savelo.com",
      "type": "string",
      "description": "Email untuk testing (unique per run)"
    },
    {
      "key": "test_password",
      "value": "Password123",
      "type": "string"
    },
    {
      "key": "auth_token",
      "value": "",
      "type": "string",
      "description": "Diisi otomatis setelah login/register"
    },
    {
      "key": "test_city",
      "value": "Yogyakarta",
      "type": "string"
    },
    {
      "key": "place_id",
      "value": "",
      "type": "string",
      "description": "Diisi otomatis dari response destinations"
    },
    {
      "key": "destination_id",
      "value": "",
      "type": "string",
      "description": "Diisi otomatis dari response favorites"
    },
    {
      "key": "itinerary_id",
      "value": "",
      "type": "string",
      "description": "Diisi otomatis dari generate itinerary"
    },
    {
      "key": "request_id",
      "value": "",
      "type": "string",
      "description": "Diisi otomatis dari generate itinerary"
    },
    {
      "key": "item_id",
      "value": "",
      "type": "string",
      "description": "Diisi otomatis dari itinerary response"
    },
    {
      "key": "day_number",
      "value": "1",
      "type": "string"
    }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{auth_token}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "1. Authentication",
      "item": [
        {
          "name": "Register & Verify",
          "item": [
            {
              "name": "1.1 Register - Send OTP",
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "exec": [
                      "pm.test('Status 200', () => pm.response.to.have.status(200));",
                      "pm.test('OTP sent', () => {",
                      "    const json = pm.response.json();",
                      "    pm.expect(json.success).to.be.true;",
                      "    pm.expect(json.message).to.include('OTP');",
                      "});",
                      "",
                      "// Simulasi OTP untuk testing (dalam production, ambil dari email)",
                      "// Untuk testing manual, set variable otp_code dari database/email",
                      "pm.collectionVariables.set('otp_code', '123456');"
                    ],
                    "type": "text/javascript"
                  }
                }
              ],
              "request": {
                "method": "POST",
                "header": [
                  {"key": "Content-Type", "value": "application/json"},
                  {"key": "Accept", "value": "application/json"}
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"name\": \"Test User Savelo\",\n  \"email\": \"{{test_email}}\",\n  \"password\": \"{{test_password}}\"\n}"
                },
                "url": {
                  "raw": "{{base_url}}/auth/register",
                  "host": ["{{base_url}}"],
                  "path": ["auth", "register"]
                }
              }
            },
            {
              "name": "1.2 Verify OTP",
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "exec": [
                      "pm.test('Status 201', () => pm.response.to.have.status(201));",
                      "pm.test('Token received', () => {",
                      "    const json = pm.response.json();",
                      "    pm.expect(json.data.token).to.be.a('string');",
                      "    pm.collectionVariables.set('auth_token', json.data.token);",
                      "    console.log('✓ Token saved:', json.data.token.substring(0, 20) + '...');",
                      "});"
                    ],
                    "type": "text/javascript"
                  }
                }
              ],
              "request": {
                "method": "POST",
                "header": [
                  {"key": "Content-Type", "value": "application/json"},
                  {"key": "Accept", "value": "application/json"}
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"email\": \"{{test_email}}\",\n  \"otp\": \"{{otp_code}}\"\n}"
                },
                "url": {
                  "raw": "{{base_url}}/auth/register/verify",
                  "host": ["{{base_url}}"],
                  "path": ["auth", "register", "verify"]
                },
                "description": "Untuk testing otomatis: set otp_code di database atau gunakan OTP yang valid"
              }
            }
          ]
        },
        {
          "name": "1.3 Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Token received', () => {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json.data.token).to.be.a('string');",
                  "    pm.collectionVariables.set('auth_token', json.data.token);",
                  "    console.log('✓ Token saved from login');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {"key": "Content-Type", "value": "application/json"},
              {"key": "Accept", "value": "application/json"}
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{test_email}}\",\n  \"password\": \"{{test_password}}\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/auth/login",
              "host": ["{{base_url}}"],
              "path": ["auth", "login"]
            }
          }
        },
        {
          "name": "1.4 Logout",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [{"key": "token", "value": "{{auth_token}}", "type": "string"}]
            },
            "method": "POST",
            "header": [
              {"key": "Accept", "value": "application/json"}
            ],
            "url": {
              "raw": "{{base_url}}/auth/logout",
              "host": ["{{base_url}}"],
              "path": ["auth", "logout"]
            }
          }
        }
      ]
    },
    {
      "name": "2. Destinations",
      "item": [
        {
          "name": "2.1 Get City Destinations",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Has destinations', () => {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json.data.destinations).to.be.an('array');",
                  "    if (json.data.destinations.length > 0) {",
                  "        const firstPlace = json.data.destinations[0];",
                  "        pm.collectionVariables.set('place_id', firstPlace.place_id);",
                  "        pm.collectionVariables.set('destination_id', firstPlace.id);",
                  "        console.log('✓ place_id saved:', firstPlace.place_id);",
                  "    }",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [{"key": "token", "value": "{{auth_token}}", "type": "string"}]
            },
            "method": "GET",
            "header": [
              {"key": "Accept", "value": "application/json"}
            ],
            "url": {
              "raw": "{{base_url}}/destinations?city={{test_city}}",
              "host": ["{{base_url}}"],
              "path": ["destinations"],
              "query": [{"key": "city", "value": "{{test_city}}"}]
            }
          }
        },
        {
          "name": "2.2 Get Destination Detail",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.collectionVariables.get('place_id')) {",
                  "    pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "    pm.test('Has destination data', () => {",
                  "        const json = pm.response.json();",
                  "        pm.expect(json.data.destination).to.be.an('object');",
                  "    });",
                  "} else {",
                  "    pm.test.skip('No place_id available');",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [{"key": "token", "value": "{{auth_token}}", "type": "string"}]
            },
            "method": "GET",
            "header": [
              {"key": "Accept", "value": "application/json"}
            ],
            "url": {
              "raw": "{{base_url}}/destinations/{{place_id}}",
              "host": ["{{base_url}}"],
              "path": ["destinations", "{{place_id}}"]
            }
          }
        },
        {
          "name": "2.3 Get Map Pins",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Has map data', () => {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json.data.destinations).to.be.an('array');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [{"key": "token", "value": "{{auth_token}}", "type": "string"}]
            },
            "method": "GET",
            "header": [
              {"key": "Accept", "value": "application/json"}
            ],
            "url": {
              "raw": "{{base_url}}/destinations/map?city={{test_city}}",
              "host": ["{{base_url}}"],
              "path": ["destinations", "map"],
              "query": [{"key": "city", "value": "{{test_city}}"}]
            }
          }
        }
      ]
    },
    {
      "name": "3. Favorites",
      "item": [
