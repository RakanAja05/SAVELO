            },
            "method": "GET",
            "header": [
              {"key": "Accept", "value": "application/json"}
            ],
            "url": {
              "raw": "{{base_url}}/itineraries/requests/{{request_id}}",
              "host": ["{{base_url}}"],
              "path": ["itineraries", "requests", "{{request_id}}"]
            }
          }
        },
        {
          "name": "4.4 Get Day Plan",
