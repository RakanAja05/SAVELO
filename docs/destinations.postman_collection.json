            "value": "application/json"
          }
        ],
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{token}}",
              "type": "string"
            }
          ]
        },
        "url": {
          "raw": "{{base_url}}/api/destinations?city=Yogyakarta",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "destinations"
          ],
          "query": [
            {
              "key": "city",
              "value": "Yogyakarta"
            }
          ]
        }
      }
    },
